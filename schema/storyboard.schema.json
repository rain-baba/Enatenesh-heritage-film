{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Short storyboard",
  "description": "The contract between every pipeline stage. Each stage reads this file and writes only its own outputs.",
  "type": "object",
  "required": [
    "title",
    "language",
    "audience",
    "intent",
    "style",
    "models",
    "timing",
    "shots",
    "music",
    "end_card"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "logline": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "description": "BCP-47 code of the narration language, e.g. am"
    },
    "audience": {
      "type": "string",
      "minLength": 10
    },
    "intent": {
      "type": "string",
      "minLength": 10,
      "description": "What the audience should feel or understand at the end"
    },
    "style": {
      "type": "object",
      "required": [
        "style_block",
        "characters"
      ],
      "additionalProperties": false,
      "properties": {
        "style_block": {
          "type": "string",
          "minLength": 10,
          "description": "Added to every image prompt"
        },
        "characters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "description",
              "sheet_prompt",
              "seed"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "description": {
                "type": "string",
                "minLength": 10,
                "description": "Added to every prompt where the character appears"
              },
              "sheet_prompt": {
                "type": "string",
                "minLength": 10
              },
              "seed": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "required": [
        "text",
        "tts",
        "image",
        "video",
        "music"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "object",
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "type": "string"
            }
          }
        },
        "tts": {
          "type": "object",
          "required": [
            "model",
            "voice",
            "style_instruction"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string"
            },
            "voice": {
              "type": "string"
            },
            "style_instruction": {
              "type": "string"
            },
            "fallback_models": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tried in order when a model's quota is exhausted or it keeps failing"
            }
          }
        },
        "image": {
          "type": "object",
          "required": [
            "model",
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string"
            },
            "width": {
              "type": "integer",
              "minimum": 256,
              "maximum": 2048
            },
            "height": {
              "type": "integer",
              "minimum": 256,
              "maximum": 2048
            },
            "use_references": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "video": {
          "type": "object",
          "required": [
            "model",
            "width",
            "height",
            "num_frames",
            "steps",
            "guidance"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string"
            },
            "width": {
              "type": "integer",
              "multipleOf": 32
            },
            "height": {
              "type": "integer",
              "multipleOf": 32
            },
            "num_frames": {
              "type": "integer",
              "minimum": 17,
              "description": "Must be 4k+1 for Wan"
            },
            "steps": {
              "type": "integer",
              "minimum": 4,
              "maximum": 60
            },
            "guidance": {
              "type": "number",
              "minimum": 1,
              "maximum": 10
            },
            "fps": {
              "type": "integer",
              "default": 24
            }
          }
        },
        "music": {
          "type": "object",
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "type": "string"
            }
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "required": [
        "pad_before_s",
        "pad_after_s",
        "min_shot_s"
      ],
      "additionalProperties": false,
      "properties": {
        "pad_before_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "pad_after_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "min_shot_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 12
        },
        "voice_tempo": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 1.25,
          "default": 1.0,
          "description": "Speed-up applied to narration in the edit (pitch kept), to fit 60-90 s without regenerating audio"
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason",
          "shot_size",
          "characters",
          "image_prompt",
          "motion_prompt",
          "seed",
          "narration",
          "subtitle_en",
          "render"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]{2}$"
          },
          "beat": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "description": "Why this shot exists"
          },
          "shot_size": {
            "enum": [
              "extreme_wide",
              "wide",
              "medium",
              "medium_close",
              "close",
              "extreme_close",
              "insert"
            ]
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_prompt": {
            "type": "string",
            "minLength": 10
          },
          "motion_prompt": {
            "type": "string",
            "minLength": 5
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "narration": {
            "type": "string",
            "description": "Spoken line in the narration language; empty for a silent shot"
          },
          "narration_en": {
            "type": "string",
            "description": "Working English meaning of the line"
          },
          "subtitle_en": {
            "type": "string"
          },
          "render": {
            "enum": [
              "wan",
              "kenburns"
            ],
            "description": "wan = image-to-video on GPU, kenburns = pan and zoom over the keyframe"
          },
          "kenburns": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "zoom": {
                "enum": [
                  "in",
                  "out"
                ]
              },
              "pan": {
                "enum": [
                  "none",
                  "left",
                  "right",
                  "up",
                  "down"
                ]
              }
            }
          },
          "min_duration_s": {
            "type": "number",
            "minimum": 2,
            "maximum": 15
          },
          "outfits": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Per-shot clothing override by character id; replaces the 'wearing ...' part of the description"
          }
        }
      }
    },
    "music": {
      "type": "object",
      "required": [
        "caption",
        "bpm",
        "keyscale",
        "duration_s",
        "instrumental",
        "candidate_seeds",
        "chosen",
        "cues"
      ],
      "additionalProperties": false,
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 10
        },
        "bpm": {
          "type": "integer",
          "minimum": 40,
          "maximum": 200
        },
        "keyscale": {
          "type": "string"
        },
        "duration_s": {
          "type": "number",
          "minimum": 20,
          "maximum": 180
        },
        "instrumental": {
          "type": "boolean"
        },
        "candidate_seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        },
        "chosen": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Seed of the chosen candidate, or null for placeholder music"
        },
        "chosen_reason": {
          "type": "string"
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at_shot",
              "note"
            ],
            "properties": {
              "at_shot": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "music_lufs": {
          "type": "number",
          "minimum": -40,
          "maximum": -14,
          "default": -26,
          "description": "Loudness of the score before ducking; the voice sits at -16 LUFS"
        }
      }
    },
    "end_card": {
      "type": "object",
      "required": [
        "lines",
        "seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "seconds": {
          "type": "number",
          "minimum": 2,
          "maximum": 6
        }
      }
    }
  }
}
